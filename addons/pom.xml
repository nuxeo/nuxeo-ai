<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.nuxeo.ai</groupId>
    <artifactId>ai-core-parent</artifactId>
    <version>5.0.3-SNAPSHOT</version>
  </parent>
  <artifactId>nuxeo-ai-addons</artifactId>
  <name>Nuxeo AI Addons parent POM</name>
  <packaging>pom</packaging>
  <description>Nuxeo AI Addons parent POM</description>

  <properties>
    <nuxeo.content.intelligence.connector.version>2025.0.0</nuxeo.content.intelligence.connector.version>
  </properties>

  <modules>
    <module>nuxeo-ai-image-quality-core</module>
    <module>nuxeo-ai-image-quality-package</module>
    <module>nuxeo-ai-aws-core</module>
    <module>nuxeo-ai-aws-package</module>
    <module>nuxeo-ai-gcp-core</module>
    <module>nuxeo-ai-gcp-package</module>
    <module>nuxeo-ai-content-intelligence-core</module>
    <module>nuxeo-ai-content-intelligence-package</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- Only manage project-specific dependencies here; AWS SDK dependencies are managed by the BOM in the root POM and should not be listed here. -->
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-aws-core</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-gcp-core</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-image-quality-core</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-content-intelligence-core</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.content.intelligence</groupId>
        <artifactId>nuxeo-content-intelligence-connector-core</artifactId>
        <version>${nuxeo.content.intelligence.connector.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
