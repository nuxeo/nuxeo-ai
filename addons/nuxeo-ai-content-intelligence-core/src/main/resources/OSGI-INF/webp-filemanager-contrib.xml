<?xml version="1.0"?>
<!--
  Routes uploaded WebP blobs to Picture documents so they flow into the image enrichment pipeline, by
  re-contributing the platform's Imageplugin with merge="true" to APPEND image/webp to its filter list.

  Why the plugin declares no class and requires the picture contribution:
    The base Imageplugin (class org.nuxeo.ecm.platform.picture.extension.ImagePlugin) is contributed by the
    imaging bundle's component org.nuxeo.ecm.platform.picture.filemanager.contrib. FileImporterDescriptor#merge
    only merges when the INCOMING descriptor sets merge="true", APPENDS the incoming filters to the base ones,
    and inherits the base class when the incoming descriptor omits it. We therefore:
      - <require> that base component so our contribution is always registered AFTER it (otherwise the base,
        which has merge="false", would replace ours and the image/webp filter would be silently dropped);
      - omit the class attribute so this contribution never references ImagePlugin directly (avoiding any
        ClassNotFound if the imaging bundle is absent) and simply inherits it through the merge.

  This contribution is deliberately separate from org.nuxeo.ai.contentintelligence.webp.mimetype: the WebP
  MIME-type registration must stay always-on and must not be gated on the imaging/picture bundle.
-->
<component name="org.nuxeo.ai.contentintelligence.webp.filemanager" version="1.0">

  <require>org.nuxeo.ecm.platform.filemanager.service.FileManagerService</require>
  <require>org.nuxeo.ecm.platform.picture.filemanager.contrib</require>

  <extension target="org.nuxeo.ecm.platform.filemanager.service.FileManagerService" point="plugins">
    <plugin name="Imageplugin" merge="true">
      <filter>image/webp</filter>
    </plugin>
  </extension>

</component>
