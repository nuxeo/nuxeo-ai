<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.nuxeo</groupId>
    <artifactId>nuxeo-parent</artifactId>
    <version>2025.24</version>
  </parent>

  <groupId>org.nuxeo.ai</groupId>
  <artifactId>ai-core-parent</artifactId>
  <version>5.0.3-SNAPSHOT</version>
  <name>Ai core parent</name>
  <description>Nuxeo AI functionality</description>
  <packaging>pom</packaging>

  <properties>
    <nuxeo.ai.version>${project.version}</nuxeo.ai.version>
    <dropwizard.version>4.2.40</dropwizard.version>
    <nuxeo.target.version>${nuxeo.platform.version}</nuxeo.target.version>
    <nuxeo.java.client.version>4.0.0</nuxeo.java.client.version>
    <wiremock.version>2.27.2</wiremock.version>
    <nuxeo.log4j.version>1.1.0</nuxeo.log4j.version>
    <nuxeo.webui.version>3.0.6</nuxeo.webui.version>
    <nuxeo.insight-demos.version>1.3.2-11</nuxeo.insight-demos.version>
    <nuxeo.ai.client.version>1.4.0</nuxeo.ai.client.version>
    <nuxeo.ai.jwt.version>3.0.0</nuxeo.ai.jwt.version>
    <gcp.version>26.88.0</gcp.version>
    <aws.sdk.version>2.54.13</aws.sdk.version>
    <grpc-netty.version>1.84.0</grpc-netty.version>
    <google.protobuf.version>4.36.1</google.protobuf.version>
    <jakarta.validation.version>3.0.2</jakarta.validation.version>
    <jakarta.mail.api.version>2.0.1</jakarta.mail.api.version>
    <jakarta.annotation.version>2.1.1</jakarta.annotation.version>
    <!-- JaCoCo Configuration -->
    <jacoco.version>0.8.15</jacoco.version>
    <jacoco.aggregateReportDirectory>jacoco-aggregate</jacoco.aggregateReportDirectory>
    <!-- SonarCloud Configuration -->
    <sonar.organization>nuxeo</sonar.organization>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.projectKey>nuxeo_nuxeo-ai</sonar.projectKey>
    <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/nuxeo-ai-core-package/target/site/${jacoco.aggregateReportDirectory}/jacoco.xml,${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    <sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
  </properties>

  <modules>
    <module>nuxeo-ai-pipes</module>
    <module>nuxeo-ai-core</module>
    <module>nuxeo-ai-model</module>
    <module>nuxeo-ai-config</module>
    <module>nuxeo-ai-web-ui</module>
    <module>nuxeo-ai-internal</module>
    <module>nuxeo-ai-core-package</module>
    <module>addons</module>
    <module>nuxeo-ai-similar-content</module>
  </modules>

  <repositories>
    <repository>
      <id>maven-public-lts</id>
      <url>https://packages.nuxeo.com/repository/maven-public-lts</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </snapshots>
    </repository>
    <!-- Still needed for parent of org.nuxeo.ai:nuxeo-jwt-authenticator-core -->
    <repository>
      <id>maven-internal</id>
      <url>https://packages.nuxeo.com/repository/maven-internal</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>maven-public-lts</id>
      <url>https://packages.nuxeo.com/repository/maven-public-lts</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>

  <dependencyManagement>
    <dependencies>
      <!-- AWS SDK v2 BOM should be the first entry -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.sdk.version}</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>
      <dependency>
        <groupId>com.google.cloud</groupId>
        <artifactId>libraries-bom</artifactId>
        <version>${gcp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-pipes</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-pipes</artifactId>
        <type>test-jar</type>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-core</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-core</artifactId>
        <type>test-jar</type>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-model</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-config</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-internal</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-similar-content</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ecm.core</groupId>
        <artifactId>nuxeo-core-search</artifactId>
        <classifier>tests</classifier>
        <version>${nuxeo.platform.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-web-ui</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-ai-core-package</artifactId>
        <version>${nuxeo.ai.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.tomakehurst</groupId>
        <artifactId>wiremock-standalone</artifactId>
        <version>${wiremock.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.client</groupId>
        <artifactId>nuxeo-java-client</artifactId>
        <version>${nuxeo.java.client.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.log4j</groupId>
        <artifactId>nuxeo-log4j-core</artifactId>
        <version>${nuxeo.log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.dropwizard.metrics</groupId>
        <artifactId>metrics-core</artifactId>
        <version>${dropwizard.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>insight-rest-objects</artifactId>
        <version>${nuxeo.ai.client.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>insight-rest-client</artifactId>
        <version>${nuxeo.ai.client.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-jwt-authenticator-core</artifactId>
        <version>${nuxeo.ai.jwt.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.ai</groupId>
        <artifactId>nuxeo-jwt-authenticator-jaxrs</artifactId>
        <version>${nuxeo.ai.jwt.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${google.protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-auth</artifactId>
        <version>${grpc-netty.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-core</artifactId>
        <version>${grpc-netty.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-netty-shaded</artifactId>
        <version>${grpc-netty.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-stub</artifactId>
        <version>${grpc-netty.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-grpclb</artifactId>
        <version>${grpc-netty.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-alts</artifactId>
        <version>${grpc-netty.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-api</artifactId>
        <version>${grpc-netty.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-context</artifactId>
        <version>${grpc-netty.version}</version>
        <exclusions>
          <exclusion>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-protobuf</artifactId>
        <version>${grpc-netty.version}</version>
        <exclusions>
          <exclusion>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-protobuf-lite</artifactId>
        <version>${grpc-netty.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine}</argLine>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <systemPropertyVariables combine.children="append">
              <!--suppress UnresolvedMavenProperty -->
              <elasticsearch.httpReadOnly.baseUrl>${nuxeo.test.elasticsearch.addressList}</elasticsearch.httpReadOnly.baseUrl>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-help-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <scm>
    <connection>scm:git:git://github.com/nuxeo/nuxeo-ai.git</connection>
    <developerConnection>scm:git:ssh://git@github.com:nuxeo/nuxeo-ai.git</developerConnection>
    <url>https://nuxeo.github.io</url>
  </scm>

  <distributionManagement>
    <repository>
      <id>maven-public-releases</id>
      <url>https://packages.nuxeo.com/repository/maven-public-releases/</url>
    </repository>
    <snapshotRepository>
      <id>maven-public-snapshots</id>
      <url>https://packages.nuxeo.com/repository/maven-public-snapshots/</url>
      <uniqueVersion>true</uniqueVersion>
    </snapshotRepository>
  </distributionManagement>

  <profiles>
    <profile>
      <id>internal</id>
      <modules>
        <module>nuxeo-ai-internal</module>
      </modules>
    </profile>
  </profiles>

</project>
